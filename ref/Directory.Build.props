<Project>
  <!-- Compile-only stand-ins for Jellyfin's assemblies (NuGet is not reachable from the build machine).
       They contain only the members this plugin uses, with Jellyfin 12.x signatures, and are never shipped. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyVersion>12.0.0.0</AssemblyVersion>
    <FileVersion>12.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
</Project>
